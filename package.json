{
  "name": "neat-admin-template",
  "version": "1.0.0",
  "description": "🚀 Enterprise-level admin template built with React 18 + TypeScript + Neat Design. Features automatic route generation, i18n, permission control, and responsive layout. Production-ready.",
  "scripts": {
    "start": "node pack.js",
    "clean": "rimraf dist",
    "doc": "node doc.js",
    "lint": "eslint --ext .ts,.tsx src",
    "build:qa": "npm i && npm run clean && node build --env=qa",
    "build:uat": "npm i && npm run clean && node build --env=uat",
    "build:prod": "npm i && npm run clean && node build --env=production"
  },
  "author": "leon.wang",
  "license": "ISC",
  "dependencies": {
    "@ahooksjs/use-url-state": "^3.5.1",
    "@derbysoft/antd-form-builder": "^1.0.0",
    "@derbysoft/derbysoft-all-in-one-help-widget": "^2.3.14",
    "@derbysoft/neat-design": "^2.2.2",
    "@derbysoft/neat-design-icons": "^1.2.6",
    "@derbysoft/neat-design-illustrations": "^1.0.15",
    "@derbysoft/zustand-kit": "^1.1.3",
    "ahooks": "^3.9.0",
    "antd": "^5.29.2",
    "axios": "^1.11.0",
    "classnames": "^2.5.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.13",
    "fuse.js": "^7.1.0",
    "i18next": "^25.3.2",
    "lodash": "^4.17.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.7",
    "react-i18next": "^15.6.1",
    "react-router": "^7.7.1",
    "urijs": "^1.19.11",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@derbysoft/pack": "~1.0.6",
    "@eslint/js": "^9.29.0",
    "@types/node": "^24.2.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss-plugin-px2rem": "^0.8.1",
    "react-scan": "^0.4.3",
    "rimraf": "^5.0.5",
    "typescript": "<5.9.0",
    "typescript-eslint": "^8.46.4",
    "yargs": "^18.0.0"
  }
}
